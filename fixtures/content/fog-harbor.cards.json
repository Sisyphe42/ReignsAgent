{
  "metadata": {
    "title": "雾港",
    "version": "1.0.0",
    "author": "演示项目",
    "description": "你是雾港新任的港务长。灯油、渔民、商会和议会，每一夜只能顾上一头。",
    "i18n": {
      "defaultLocale": "zh-Hans",
      "supportedLocales": [
        "zh-Hans"
      ]
    },
    "tagLabels": {
      "onWatch": "已到任",
      "lampAllNight": "整夜长明",
      "lampRationed": "整点亮灯",
      "oilDebt": "欠油商的账",
      "oilRefused": "谢绝赊账",
      "noticeEnforced": "告示重贴",
      "noticeSoftened": "改半点亮灯",
      "berthSold": "东泊位让出",
      "taxPledged": "港务税抵账",
      "reserveBurned": "备用油烧尽",
      "shipsWaited": "船在外海过夜",
      "boatSearched": "拦过暗船",
      "boatIgnored": "放过暗船",
      "seized": "烟草扣押",
      "hushed": "补税放人",
      "giftTaken": "收下无名灯油",
      "giftDeclared": "灯油上交登记",
      "recordsOpen": "记录全数交出",
      "recordsCooked": "交了誊过的记录",
      "harborClosed": "封港一天",
      "fleetSailed": "船队出海",
      "searchSent": "拖船出海搜救",
      "searchDelayed": "搜救拖到天亮",
      "whaleSaved": "鲸回到海里",
      "whaleSold": "鲸卖给油商",
      "fundSet": "抚恤金设立",
      "fundDeferred": "抚恤金待表决",
      "dredging": "航道疏浚",
      "dredgeDeferred": "疏浚暂缓",
      "netsPaid": "渔网获赔",
      "crowdDispersed": "渔民被劝散",
      "foghornOn": "蒸汽雾号",
      "bellKept": "继续敲钟",
      "keeperDaughter": "女儿接任守灯人",
      "keeperOutsider": "外聘守灯人",
      "auditFaced": "账目摊开",
      "auditCovered": "商会担保",
      "endorsed": "渔会推举连任",
      "coalition": "两边各出副手",
      "endingLogged": "写进港志",
      "endingQuiet": "熄灯回家",
      "quarantineLifted": "检疫解除",
      "warehouseChecked": "医生先进仓",
      "warehouseOpened": "七号仓卸货"
    },
    "presentation": {
      "schemaVersion": 1,
      "gauges": {
        "gauge0": {
          "label": "商会",
          "description": "货主、油商和轮船公司怎么看你。"
        },
        "gauge1": {
          "label": "渔民",
          "description": "渔会和码头上的人怎么看你。"
        },
        "gauge2": {
          "label": "灯油",
          "description": "灯塔还能亮多少个晚上。"
        },
        "gauge3": {
          "label": "议会",
          "description": "镇议会还愿不愿意让你签字。"
        }
      },
      "css": {
        "variables": {},
        "text": ""
      },
      "html": {},
      "js": {},
      "policy": {
        "allowCssText": false,
        "allowHtml": false,
        "allowJs": false
      }
    },
    "story": {
      "groups": [
        {
          "id": "first-night",
          "label": "第一夜",
          "type": "chapter",
          "description": "到任当晚的决定，把故事分成长明与省油两路。",
          "cardIds": [
            "first-fog"
          ]
        },
        {
          "id": "oil-line",
          "label": "灯油线",
          "type": "chapter",
          "description": "赊账、告示与见底的油桶。",
          "cardIds": [
            "oil-merchant",
            "ration-notice",
            "debt-collector",
            "last-oil"
          ]
        },
        {
          "id": "dark-boat-line",
          "label": "暗船线",
          "type": "chapter",
          "description": "一条没挂灯的船，牵出议长的外甥和省里的稽查。",
          "cardIds": [
            "night-boat",
            "contraband",
            "quiet-gift",
            "customs-inspector"
          ]
        },
        {
          "id": "storm-line",
          "label": "风暴线",
          "type": "chapter",
          "description": "封港还是出海，以及之后要还的账。",
          "cardIds": [
            "storm-warning",
            "missing-boat",
            "stranded-whale",
            "widow-fund"
          ]
        },
        {
          "id": "channel-line",
          "label": "航道线",
          "type": "chapter",
          "description": "轮船公司、雾号和守灯人的人选。",
          "cardIds": [
            "steamship",
            "dredge-nets",
            "foghorn",
            "lighthouse-keeper"
          ]
        },
        {
          "id": "reckoning",
          "label": "清算",
          "type": "chapter",
          "description": "议会查账或镇民大会，取决于前面欠下的是哪一种账。",
          "cardIds": [
            "council-audit",
            "town-meeting"
          ]
        },
        {
          "id": "debts",
          "label": "欠下的账",
          "type": "theme",
          "description": "所有以后会被追问的决定。",
          "tags": [
            "oilDebt",
            "berthSold",
            "taxPledged",
            "giftTaken",
            "hushed",
            "recordsCooked",
            "whaleSold"
          ]
        },
        {
          "id": "goodwill",
          "label": "攒下的人情",
          "type": "theme",
          "description": "渔民会记住的事。",
          "tags": [
            "whaleSaved",
            "fundSet",
            "netsPaid",
            "keeperDaughter",
            "searchSent",
            "seized"
          ]
        },
        {
          "id": "morning-endings",
          "label": "雾散的早晨",
          "type": "ending",
          "description": "熬过清算之后的两种收场。",
          "tags": [
            "endingLogged",
            "endingQuiet"
          ]
        }
      ]
    },
