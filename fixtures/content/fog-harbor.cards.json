  "cards": [
    {
      "id": "first-fog",
      "text": "你接任港务长的第一夜，海雾漫进了港口。灯塔的油只够烧到月底。",
      "weight": 3,
      "requirements": {
        "noneTags": [
          "onWatch"
        ]
      },
      "choices": [
        {
          "id": "left",
          "label": "整夜长明",
          "effects": {
            "factions": {
              "gauge2": -8,
              "gauge1": 6
            },
            "tags": {
              "onWatch": true,
              "lampAllNight": true
            },
            "variables": {
              "nightPolicy": "bright"
            }
          }
        },
        {
          "id": "right",
          "label": "只在整点亮灯",
          "effects": {
            "factions": {
              "gauge2": 5,
              "gauge0": -5,
              "gauge1": -4
            },
            "tags": {
              "onWatch": true,
              "lampRationed": true
            },
            "variables": {
              "nightPolicy": "ration"
            }
          }
        }
      ]
    },
    {
      "id": "oil-merchant",
      "text": "油商愿意赊给你三十桶鲸油，条件是他的货船优先靠岸。",
      "weight": 1,
      "requirements": {
        "allTags": [
          "lampAllNight"
        ]
      },
      "choices": [
        {
          "id": "left",
          "label": "签下赊账",
          "effects": {
            "factions": {
              "gauge2": 14,
              "gauge1": -6,
              "gauge0": 4
            },
            "tags": {
              "oilDebt": true
            }
          }
        },
        {
          "id": "right",
          "label": "婉言谢绝",
          "effects": {
            "factions": {
              "gauge2": -5,
              "gauge3": 5
            },
            "tags": {
              "oilRefused": true
            }
          }
        }
      ]
    },
    {
      "id": "ration-notice",
      "text": "整点亮灯的告示贴出去了。渔会的人把它撕了下来。",
      "weight": 1,
      "requirements": {
        "allTags": [
          "lampRationed"
        ]
      },
      "choices": [
        {
          "id": "left",
          "label": "重新贴上",
          "effects": {
            "factions": {
              "gauge3": 6,
              "gauge1": -8
            },
            "tags": {
              "noticeEnforced": true
            }
          }
        },
        {
          "id": "right",
          "label": "改成半点亮灯",
          "effects": {
            "factions": {
              "gauge2": -7,
              "gauge1": 7
            },
            "tags": {
              "noticeSoftened": true
            }
          }
        }
      ]
    },
    {
      "id": "debt-collector",
      "text": "油商来收账了。他不要钱，要码头东侧的泊位。",
      "weight": 1,
      "requirements": {
        "allTags": [
          "oilDebt"
        ]
      },
      "choices": [
        {
          "id": "left",
          "label": "让出泊位",
          "effects": {
            "factions": {
              "gauge0": 9,
              "gauge1": -10
            },
            "tags": {
              "berthSold": true
            }
          }
        },
        {
          "id": "right",
          "label": "拿港务税抵账",
          "effects": {
            "factions": {
              "gauge3": -9,
              "gauge2": -4
            },
            "tags": {
              "taxPledged": true
            }
          }
        }
      ]
    },
    {
      "id": "last-oil",
      "text": "灯油见底了。今晚有三条船预定进港。",
      "weight": 1,
      "requirements": {
        "allTags": [
          "onWatch"
        ],
        "factions": {
          "gauge2": {
            "max": 30
          }
        }
      },
      "choices": [
        {
          "id": "left",
          "label": "烧掉最后的备用油",
          "effects": {
            "factions": {
              "gauge2": -12,
              "gauge0": 6,
              "gauge1": 5
            },
            "tags": {
              "reserveBurned": true
            }
          }
        },
        {
          "id": "right",
          "label": "让船在外海等到天亮",
          "effects": {
            "factions": {
              "gauge0": -12,
              "gauge2": 4
            },
            "tags": {
              "shipsWaited": true
            }
          }
        }
      ]
    },
    {
      "id": "night-boat",
      "text": "雾里有条没挂灯的小船，正贴着防波堤往里走。",
      "weight": 1,
      "requirements": {
        "allTags": [
          "onWatch"
        ]
      },
      "choices": [
        {
          "id": "left",
          "label": "拦下检查",
          "effects": {
            "factions": {
              "gauge3": 5,
              "gauge0": -5
            },
            "tags": {
              "boatSearched": true
            }
          }
        },
        {
          "id": "right",
          "label": "装作没看见",
          "effects": {
            "factions": {
              "gauge0": 6,
              "gauge3": -5
            },
            "tags": {
              "boatIgnored": true
            }
          }
        }
      ]
    },
    {
      "id": "contraband",
      "text": "船舱里是没完税的烟草。船主是议长的外甥。",
      "weight": 1,
      "requirements": {
        "allTags": [
          "boatSearched"
        ]
      },
      "choices": [
        {
          "id": "left",
          "label": "照章扣押",
          "effects": {
            "factions": {
              "gauge3": -10,
              "gauge1": 6,
              "gauge0": 3
            },
            "tags": {
              "seized": true
            },
            "variables": {
              "smuggling": "exposed"
            }
          }
        },
        {
          "id": "right",
          "label": "补了税就放人",
          "effects": {
            "factions": {
              "gauge3": 7,
              "gauge1": -5,
              "gauge2": 5
            },
            "tags": {
              "hushed": true
            },
            "variables": {
              "smuggling": "covered"
            }
          }
        }
      ]
    },
